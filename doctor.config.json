{
	"$schema": "https://react.doctor/schema/config.json",
	"rules": {
		"react-doctor/query-mutation-missing-invalidation": "off",
		"deslop/unused-dependency": "off"
	},
	"ignore": {
		"overrides": [
			{
				"files": ["src/components/ui/**"],
				"rules": ["react-doctor/only-export-components"]
			}
		]
	}
}
