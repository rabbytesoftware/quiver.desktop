{
	"name": "quiver-desktop-e2e",
	"private": true,
	"type": "module",
	"description": "tauri-driver + WebdriverIO E2E harness for the self-update / self-arrow scenarios. Linux and Windows only -- tauri-driver has no macOS backend (see README.md).",
	"scripts": {
		"test": "wdio run ./wdio.conf.ts",
		"test:bootstrap": "wdio run ./wdio.conf.ts --spec ./scenarios/bootstrap.spec.ts",
		"test:self-update": "wdio run ./wdio.conf.ts --spec ./scenarios/self-update-while-running.spec.ts",
		"test:outdated-badge": "wdio run ./wdio.conf.ts --spec ./scenarios/generic-outdated-badge.spec.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"@wdio/cli": "^9.5.0",
		"@wdio/globals": "^9.5.0",
		"@wdio/local-runner": "^9.5.0",
		"@wdio/mocha-framework": "^9.5.0",
		"@wdio/spec-reporter": "^9.5.0",
		"@wdio/types": "^9.5.0",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.2",
		"typescript": "~5.6.3",
		"webdriverio": "^9.5.0"
	}
}
