{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node", "@wdio/globals/types", "@wdio/mocha-framework"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules"]
}
