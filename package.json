    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-router": "^1.168.23",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.28.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.4",
    "zustand": "^5.0.13"
  },
  "quiver": {
    "_comment": "Must be an immutable quiver.core tag. Never `nightly`: that tag is deleted and recreated on every push to quiver.core's develop, so a build pinned to it is not reproducible — and CI's check only asks whether the tag exists, which `nightly` always does.",
    "coreVersion": "nightly"
  },
