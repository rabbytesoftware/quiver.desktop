# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Sidecar binaries (fetched at build/dev time, never committed)
src-tauri/binaries/

# Icon build artifacts, generated by icons-compiler/compile-icon.sh from the
# quiver.icon source bundle. The .icon itself IS tracked; these are not.
src-tauri/icons/Assets.car
src-tauri/icons/quiver.icns
icons-compiler/.build/
icons-compiler/build/

# AI tooling artifacts — never commit
docs/superpowers/
.superpowers/

# Specs. Working documents that churn far faster than the code they describe
# and go stale the moment they don't — kept out so a stale spec in the tree is
# never mistaken for the source of truth. Shared out of band.
docs/spec/

coverage/

# Pencil design sources. Encrypted single-blob files that re-serialize whole on
# every edit — 3MB and ~75k lines of diff per touch, unreviewable in a PR.
# Kept on disk, shared out of band.
*.pen
